drop_db() { pg -c "set client_min_messages = warning" -c "drop database if exists \"$1\" with (force)" >/dev/null; }

# القاعدة المنقولة تُبنى كاملة باسم مؤقت؛ القاعدة الحالية (إن وُجدت) لا تُمس حتى ينجح الاستيراد
build_new_db() {   # sha
  local DB=${DB}_new
  drop_db "$DB"
  db_bootstrap
  gotrue_migrate
  db_owner_grants
  app_migrations "$1"
  import_export
}

# تبديل الاسمين في معاملة واحدة: إما القاعدة الجديدة كاملة وإما القديمة كما هي
swap_in_new_db() {
  local new=${DB}_new old=${DB}_old
  systemctl stop dalil-hama-api dalil-hama-auth >/dev/null 2>&1 || true
  drop_db "$old"
  if db_exists; then
    pg -c "select pg_terminate_backend(pid) from pg_stat_activity where datname in ('$DB', '$new') and pid <> pg_backend_pid()" >/dev/null
    pg -1 -c "alter database $DB rename to $old" -c "alter database $new rename to $DB" >/dev/null ||
      die "تعذّر وضع البيانات المنقولة مكان قاعدة السيرفر؛ لم يتغير شيء"
    drop_db "$old"
  else
    pg -c "alter database $new rename to $DB" >/dev/null || die "تعذّر وضع البيانات المنقولة في قاعدة $DB"
  fi
}

# أحدث نسخة احتياطية وطريقة استرجاعها (لرسائل الأعطال)
restore_hint() {
  local last
  last=$(ls -1t -- "$BACKUP_DIR/$DB-"*.dump 2>/dev/null | head -n 1) || last=
  if [ -z "$last" ]; then printf 'لا توجد نسخة احتياطية في %s' "$BACKUP_DIR"; return 0; fi
  printf 'لاسترجاع آخر نسخة احتياطية (%s):  sudo dalil-hama-site db-restore' "${last##*/}"
}

# config.js الإصدار الحالي، موجَّهاً إلى قاعدة السيرفر (يُعاد مع كل إصدار جديد)
write_override() {
  [ -f "$BACKEND_FLAG" ] || [ "${1:-}" = force ] || return 0
  local src=$BASE/current/assets/js/config.js dir=$OVERRIDE/assets/js
  [ -f "$src" ] || return 0
  mkdir -p "$dir"
  sed -E -e "s#^[[:space:]]*export[[:space:]]+const[[:space:]]+SUPABASE_URL[[:space:]]*=.*#export const SUPABASE_URL = '';#" \
         -e "s#^[[:space:]]*export[[:space:]]+const[[:space:]]+SUPABASE_KEY[[:space:]]*=.*#export const SUPABASE_KEY = 'local';#" \
         "$src" > "$dir/config.js.new"
  # سطر واحد بالضبط يوجّه إلى السيرفر؛ وإلا يبقى الملف السابق كما هو (لا تكرار للتصدير يكسر الموقع)
  if [ "$(grep -c "SUPABASE_URL" "$dir/config.js.new")" != 1 ] ||
     ! grep -q "^export const SUPABASE_URL = '';$" "$dir/config.js.new"; then
    rm -f -- "$dir/config.js.new"
    warn "صيغة config.js في هذا الإصدار غير متوقعة؛ أبقيت ملف الإعداد السابق"
    return 0
  fi
  chmod 644 "$dir/config.js.new"; chmod 755 "$OVERRIDE" "$OVERRIDE/assets" "$dir"
  mv -f -- "$dir/config.js.new" "$dir/config.js"
}

backend_serving() {   # expected number of published listings (or empty: any non-zero)
  local until=$((SECONDS + 30)) n
  while [ "$SECONDS" -lt "$until" ]; do
    if local_https /assets/js/config.js -H 'Cache-Control: no-cache' 2>/dev/null | grep -q "^export const SUPABASE_URL = '';" &&
       local_https /auth/v1/health 2>/dev/null | grep -q GoTrue; then
      n=$(local_https /rest/v1/rpc/sync -X POST -H 'content-type: application/json' -d '{}' 2>/dev/null |
          python3 -c 'import json,sys; print(len(json.load(sys.stdin)["items"]))' 2>/dev/null) || n=
      if [ -n "$n" ] && { { [ -z "${1:-}" ] && [ "$n" -gt 0 ]; } || [ "$n" = "${1:-}" ]; }; then return 0; fi
    fi
    sleep 1
  done
  return 1
}

