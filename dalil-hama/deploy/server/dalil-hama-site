caddy_switch() {   # local|supabase: يعيد كتابة إعداد الموقع ويفعّله؛ يعيد 1 دون تغيير إن رفضه Caddy
  local ROUTES=$1 addresses backup=$STATE/site.caddy.switch.bak pending
  # إعادة التحميل تفعّل ملف Caddy كله: لا تُفعَّل معها تعديلات معلّقة على مواقع أخرى (n8n)
  if caddy_adapt "$STATE/adapt-before.json"; then
    pending=$(pending_edits)
    if [ -n "$pending" ] && [ "$pending" != "?" ]; then
      warn "ملف Caddy فيه تعديلات لم تُفعَّل بعد على: $pending. فعّلها (sudo systemctl reload caddy) أو ألغها أولاً"
      return 1
    fi
  fi
  addresses=$(current_addresses)
  cp -p -- "$SITE_CONF" "$backup"
  write_site_conf "$addresses"
  if ! caddy_validate; then
    tail -n 5 "$STATE/validate.log" >&2 || true
    cp -p -- "$backup" "$SITE_CONF"
    return 1
  fi
  if ! caddy_reload; then
    tail -n 5 "$STATE/reload.log" >&2 || true
    cp -p -- "$backup" "$SITE_CONF"; caddy_reload || true
    return 1
  fi
}

# ─────────── الأوامر ───────────

cmd_install() {
  need_root install
  need_tools curl tar python3 flock find
  load_conf
  detect_caddy
  mkdir -p "$STATE"; chmod 700 "$STATE"

  local self sha ts analysis status file addresses backup missing cur
  self=$(readlink -f "${BASH_SOURCE[0]}")
  [ -f "$self" ] || die "نزّل الملف أولاً ثم شغّله: sudo bash /tmp/dalil-hama-site install"

  say "١/٤ تنزيل الموقع الجديد من GitHub…"
  ensure_user
  take_lock
  ensure_history
  sha=$(remote_sha) || die "تعذّر معرفة آخر إصدار من GitHub ($REPO / $BRANCH)"
  fetch_release "$sha"
  missing=$(missing_migrations "$sha")
  if [ -n "${missing// /}" ] && cur=$(current_sha) && [ -d "$BASE/releases/$cur" ]; then
    # كما في التحديث التلقائي: واجهة تحتاج مخططاً لم يُطبَّق على قاعدة السيرفر تنتظر install-db
    warn "الإصدار ${sha:0:7} يحتاج تحديث قاعدة البيانات (${missing% })، فأبقيت الموقع على ${cur:0:7}. بعد التثبيت شغّل: sudo dalil-hama-site install-db"
    sha=$cur
  fi
  activate "$sha"
  printf '%s\n' "$sha" > "$BASE/last-checked"
  rm -f -- "$BASE/PINNED" "$BASE/.last-error"
  prune
  fix_owner
  ok "الإصدار ${sha:0:7} جاهز في $BASE/current"

  say "٢/٤ تجهيز Caddy…"
  if [ "$self" != "$(readlink -f "$SELF_DST" 2>/dev/null || true)" ]; then
    install -m 755 "$self" "$SELF_DST"
  fi
  analysis=$(caddy_patch analyze "$CADDYFILE" "$HOST" "$SITE_CONF" "$STATE")
  status=$(json_get "$analysis" status)
  [ "$status" = error ] && die "$(json_get "$analysis" error)؛ لم يتغير شيء في Caddy"
  if [ "$status" = already ] && [ "$(served_sha || true)" != "$sha" ]; then
    # تثبيت سابق انقطع قبل التحقق: نعيد كتلة الموقع القديم إلى الملف أولاً ثم نثبّت من البداية
    analysis=$(caddy_patch unpatch "$CADDYFILE" "$HOST" "$SITE_CONF" "$STATE")
    [ "$(json_get "$analysis" status)" = unpatched ] || die "$(json_get "$analysis" error)؛ لم يتغير شيء في Caddy"
    analysis=$(caddy_patch analyze "$CADDYFILE" "$HOST" "$SITE_CONF" "$STATE")
    status=$(json_get "$analysis" status)
    [ "$status" = patch ] || die "$(json_get "$analysis" error)؛ لم يتغير شيء في Caddy"
  fi
  file=$(json_get "$analysis" file)
  ts=$(date +%Y%m%d-%H%M%S)
  backup="$STATE/$(basename "$file").$ts.bak"
  cp -p -- "$file" "$backup"
  [ -f "$SITE_CONF" ] && cp -p -- "$SITE_CONF" "$STATE/site.caddy.$ts.bak"

  if [ "$status" = patch ]; then
    addresses=$(json_get "$analysis" addresses)
  else
    addresses=$(current_addresses)
  fi

  restore_files() {
    cp -p -- "$backup" "$file"
    if [ -f "$STATE/site.caddy.$ts.bak" ]; then cp -p -- "$STATE/site.caddy.$ts.bak" "$SITE_CONF"; fi
  }
  restore() {
    restore_files
    caddy_reload || warn "تعذّرت إعادة تحميل Caddy بعد الاسترجاع؛ راجع: systemctl status caddy"
  }

  if [ "$status" = patch ]; then
    caddy_adapt "$STATE/adapt-before.json" ||
      { cat "$STATE/adapt.log" >&2; die "تعذّرت قراءة إعداد Caddy الحالي؛ لم يتغير شيء"; }
    # إعادة التحميل تفعّل الملف كله؛ تعديلات معلّقة على مواقع أخرى (n8n مثلاً) ستعمل معه
    local pending
    pending=$(pending_edits)
    if [ "$pending" = "?" ]; then
      warn "تعذّرت قراءة الإعداد العامل من Caddy، فلم أتحقق من التعديلات المعلّقة"
    elif [ -n "$pending" ]; then
      die "ملف Caddy فيه تعديلات لم تُفعَّل بعد على: $pending. فعّلها (systemctl reload caddy) أو ألغها أولاً؛ لم يتغير شيء"
    fi
  fi

  # انقطاع الجلسة أو Ctrl+C أثناء التعديل: نعيد الملفات كما كانت قبل الخروج
  on_abort() { trap - INT TERM HUP; restore_files 2>/dev/null || true; caddy_reload || true; exit 130; }
  trap on_abort INT TERM HUP
  write_site_conf "$addresses"
  if [ "$status" = patch ]; then
    analysis=$(caddy_patch apply "$CADDYFILE" "$HOST" "$SITE_CONF" "$STATE")
    if [ "$(json_get "$analysis" status)" != patched ]; then
      restore_files
      die "$(json_get "$analysis" error)؛ لم يتغير شيء في Caddy"
    fi
    # حارس: كل المواقع الأخرى (n8n وغيره) يجب أن تبقى كما هي حرفياً في نظر Caddy
    if ! caddy_adapt "$STATE/adapt-after.json"; then
      restore_files
      cat "$STATE/adapt.log" >&2
      die "رفض Caddy الإعداد الجديد فأعدت الملف كما كان؛ الموقع القديم يعمل كما هو"
    fi
    analysis=$(caddy_patch compare "$STATE/adapt-before.json" "$HOST" "$STATE/adapt-after.json" "$STATE")
    if [ "$(json_get "$analysis" status)" != same ]; then
      restore_files
      die "$(json_get "$analysis" error)، فأعدت الملف كما كان ولم يتغير شيء"
    fi
  fi

  say "٣/٤ فحص الإعداد وتفعيله…"
  if ! caddy_validate; then
    restore_files
    cat "$STATE/validate.log" >&2
    die "رفض Caddy الإعداد الجديد فأعدت الملف كما كان؛ الموقع القديم يعمل كما هو"
  fi
  if ! caddy_reload; then
    cat "$STATE/reload.log" >&2
    restore
    die "تعذّر تفعيل الإعداد الجديد فأعدت كل شيء كما كان؛ الموقع القديم يعمل كما هو"
  fi
  if ! wait_served "$sha"; then
    restore
    die "Caddy لم يعرض الموقع الجديد خلال 30 ثانية فأعدت كل شيء كما كان؛ الموقع القديم يعمل كما هو"
  fi
  trap - INT TERM HUP
  ok "النطاق https://$HOST يعرض الآن الموقع الجديد"

  say "٤/٤ تفعيل التحديث التلقائي…"
  install_units
  systemctl daemon-reload
  systemctl enable --now "$UNIT.timer" >/dev/null 2>&1 || warn "تعذّر تفعيل التحديث التلقائي؛ يمكنك التحديث يدوياً: sudo dalil-hama-site update"
  date -u +%FT%TZ > "$STATE/installed-at"

  say ""
  ok "تم. الموقع الجديد يعمل على https://$HOST (الإصدار ${sha:0:7})"
  say "  • يتحدّث تلقائياً كل 10 دقائق من GitHub."
  say "  • الموقع القديم ما زال يعمل في الخلفية، ولم تُمسّ قاعدة بياناته، ولا يصل إليه الزوار."
  say "  • للرجوع إلى الموقع القديم فوراً:  sudo dalil-hama-site rollback"
}

cmd_update() {
  [ "${1:-}" = --quiet ] && QUIET=1
  need_tools curl tar flock find python3 sha256sum
  load_conf
  take_lock
  ERRLOG=$BASE/.last-error
  ensure_history
  if [ -f "$BASE/PINNED" ]; then
    say "التحديث التلقائي موقوف على الإصدار $(cut -c1-7 "$BASE/PINNED"). لاستئنافه: sudo dalil-hama-site resume"
    return 0
  fi
  local sha cur f
  sha=$(remote_sha) || die "تعذّر معرفة آخر إصدار من GitHub ($REPO / $BRANCH)"
  cur=$(current_sha) || cur=
  # علامات رفض لرؤوس فرع سابقة لم تعد تلزم
  for f in "$BASE"/bad-*; do
    if [ -e "$f" ] && [ "$f" != "$BASE/bad-$sha" ]; then rm -f -- "$f"; fi
  done
  if [ -f "$BASE/bad-$sha" ]; then
    say "آخر إصدار (${sha:0:7}) مرفوض: $(cat "$BASE/bad-$sha")؛ الموقع باقٍ على ${cur:0:7}"
    return 0
  fi
  if [ "$sha" = "$cur" ] || [ "$sha" = "$(cat "$BASE/last-checked" 2>/dev/null || true)" ]; then
    rm -f -- "$ERRLOG"
    say "الموقع على آخر إصدار (${cur:0:7})"
    return 0
  fi
  fetch_release "$sha"
  local missing
  missing=$(missing_migrations "$sha")
  if [ -n "${missing// /}" ]; then
    # الواجهة الجديدة تحتاج مخططاً لم يُطبَّق بعد؛ تفعيلها الآن يكسر الموقع، فتنتظر install-db
    die "الإصدار ${sha:0:7} يحتاج تحديث قاعدة البيانات (${missing% }) فبقي الموقع على ${cur:0:7}. شغّل: sudo dalil-hama-site install-db"
  fi
  if [ -n "$cur" ] && [ -d "$BASE/releases/$cur" ] &&
     [ "$(release_digest "$BASE/releases/$sha")" = "$(release_digest "$BASE/releases/$cur")" ]; then
    # الإصدار لم يغيّر ملفات الموقع (تعديل في جزء آخر من المستودع): يبقى المعروض كما هو
    rm -rf -- "${BASE:?}/releases/$sha"
    rm -f -- "${BASE:?}/releases/$sha.migrations"
    printf '%s\n' "$sha" > "$BASE/last-checked"
    rm -f -- "$ERRLOG"
    fix_owner
    say "لا تغيير في ملفات الموقع في ${sha:0:7}؛ يبقى الإصدار ${cur:0:7}"
    return 0
  fi
  activate "$sha"
  printf '%s\n' "$sha" > "$BASE/last-checked"
  prune
  rm -f -- "$ERRLOG"
  fix_owner
  printf 'dalil-hama-site: %s -> %s\n' "${cur:0:7}" "${sha:0:7}"
}

cmd_previous() {
  need_root previous
  take_lock
  ensure_history
  local prev cur
  cur=$(current_sha) || cur=
  # الإصدار الذي سبق الحالي في السجل؛ تكرار الأمر يرجع خطوة أخرى إلى الوراء
  prev=$(awk -v c="$cur" '$0 == c { print p; exit } { p = $0 }' "$BASE/history" 2>/dev/null) || prev=
  if ! is_sha "$prev" || [ ! -d "$BASE/releases/$prev" ]; then
    die "لا يوجد إصدار أقدم محفوظ من ${cur:0:7}"
  fi
  activate "$prev" 0
  printf '%s\n' "$prev" > "$BASE/PINNED"
  rm -f -- "$BASE/last-checked"
  fix_owner
  ok "رجع الموقع إلى الإصدار ${prev:0:7} (كان ${cur:0:7})، وأُوقف التحديث التلقائي."
  say "  للرجوع خطوة أخرى كرّر الأمر. لاستئناف التحديث:  sudo dalil-hama-site resume"
}

cmd_resume() {
  need_root resume
  rm -f -- "$BASE/PINNED" "$BASE/last-checked"
  cmd_update
}

cmd_rollback() {
  need_root rollback
  need_tools python3
  detect_caddy
  local r file ts backup
  [ -f "$STATE/patched-file" ] || die "لا توجد نسخة محفوظة من إعداد الموقع القديم"
  file=$(cat "$STATE/patched-file")
  ts=$(date +%Y%m%d-%H%M%S)
  backup="$STATE/$(basename "$file").$ts.before-rollback.bak"
  cp -p -- "$file" "$backup"
  local guard=0 pending
  caddy_adapt "$STATE/adapt-before.json" && guard=1
  if [ "$guard" = 1 ]; then
    pending=$(pending_edits)
    if [ -n "$pending" ] && [ "$pending" != "?" ]; then
      warn "تنبيه: في ملف Caddy تعديلات لم تُفعَّل بعد على: $pending، وستُفعَّل مع الرجوع"
    fi
  fi
  r=$(caddy_patch unpatch "$CADDYFILE" "$HOST" "$SITE_CONF" "$STATE")
  [ "$(json_get "$r" status)" = unpatched ] || die "$(json_get "$r" error)"
  if [ "$guard" = 1 ]; then
    if caddy_adapt "$STATE/adapt-after.json"; then
      r=$(caddy_patch compare "$STATE/adapt-before.json" "$HOST" "$STATE/adapt-after.json" "$STATE")
    else
      r='{"status":"error","error":"رفض Caddy إعداد الموقع القديم"}'
    fi
    if [ "$(json_get "$r" status)" != same ]; then
      cp -p -- "$backup" "$file"
      die "$(json_get "$r" error)؛ أبقيت الموقع الجديد كما هو"
    fi
  fi
  if ! caddy_validate || ! caddy_reload; then
    cp -p -- "$backup" "$file"
    caddy_reload || true
    cat "$STATE/validate.log" "$STATE/reload.log" >&2 2>/dev/null || true
    die "تعذّر تفعيل إعداد الموقع القديم فأبقيت الموقع الجديد كما هو"
  fi
  systemctl disable --now "$UNIT.timer" >/dev/null 2>&1 || true
  systemctl is-active --quiet dalil-hama ||
    warn "خدمة الموقع القديم dalil-hama متوقفة؛ شغّلها: sudo systemctl start dalil-hama"
  ok "عاد النطاق https://$HOST إلى الموقع القديم."
  say "  لإعادة الموقع الجديد لاحقاً:  sudo dalil-hama-site install"
}

cmd_install_db() {
  need_root install-db
  local token='' replace=0 a self mode rel had_marker=0 resume=0 switched=0
  for a in "$@"; do case $a in --replace) replace=1 ;; *) token=$a ;; esac; done
  need_tools curl tar xz python3 flock psql pg_dump runuser sha256sum shred
  load_conf
  detect_caddy
  [ -f "$STATE/patched-file" ] && [ -L "$BASE/current" ] || die "ثبّت الموقع أولاً: sudo dalil-hama-site install"
  # بعد rollback إلى الموقع القديم لا يمر النطاق بإعداد الموقع الجديد، فلا معنى لتحويل قاعدته
  [ "$(json_get "$(caddy_patch analyze "$CADDYFILE" "$HOST" "$SITE_CONF" "$STATE" 2>/dev/null || echo '{}')" status)" = already ] ||
    die "النطاق لا يعرض الموقع الجديد الآن؛ شغّل أولاً: sudo dalil-hama-site install"
  systemctl is-active --quiet postgresql || die "PostgreSQL لا يعمل على هذا السيرفر"
  # live: الموقع يعمل على قاعدة السيرفر، فتحديث للخدمات والمخطط فقط
  # reattach: عمل عليها ثم أُعيد إلى Supabase، فنعود إليها كما هي دون نقل جديد
  # transfer: نقل جديد من Supabase بمفتاح النقل
  if [ -f "$BACKEND_FLAG" ]; then
    mode=live
    if [ -f "$ETC/switch-pending" ] && ! site_on_server; then
      # نقل سابق انقطع قبل أن يصل الزوار إلى قاعدة السيرفر: يُعاد بنسخة جديدة من Supabase (فيها ما أُضيف منذ ذلك الحين)
      mode=transfer; replace=1; resume=1
      say "النقل السابق انقطع قبل تحويل الموقع (والموقع ما زال على Supabase)؛ سأعيده بنسخة جديدة من Supabase."
    fi
  elif [ -n "$token" ] || [ -n "${DH_EXPORT_FILE:-}" ] || [ "$replace" = 1 ] || [ ! -f "$ETC/backend-was-live" ]; then mode=transfer
  else mode=reattach; fi
  if [ "$mode" = live ] && { [ -n "$token" ] || [ "$replace" = 1 ]; }; then
    die "الموقع يعمل على قاعدة السيرفر الآن؛ لن أستبدلها. للنقل من جديد من Supabase: sudo dalil-hama-site db-rollback ثم sudo dalil-hama-site install-db --replace"
  fi
  if [ "$mode" = transfer ] && [ -z "$token" ] && [ -z "${DH_EXPORT_FILE:-}" ]; then
    # يُطلب المفتاح هنا كي لا يظهر في قائمة العمليات وسجل sudo
    if [ ! -t 0 ]; then
      if [ "$replace" = 1 ]; then die "شغّل الأمر في الطرفية ليطلب مفتاح النقل: sudo dalil-hama-site install-db --replace"; fi
      die "شغّل الأمر في الطرفية ليطلب مفتاح النقل: sudo dalil-hama-site install-db"
    fi
    read -r -s -p "الصق مفتاح النقل ثم اضغط Enter: " token; echo
    token=${token//[$'\r\t ']/}
    [ -n "$token" ] || die "لم يُلصق مفتاح النقل؛ لم يتغير شيء"
  fi
  [ -z "$token" ] || [[ $token =~ ^[0-9a-f]{48}$ ]] || die "مفتاح النقل غير صالح"
  self=$(readlink -f "${BASH_SOURCE[0]}")
  if [ -f "$self" ] && [ "$self" != "$(readlink -f "$SELF_DST" 2>/dev/null || true)" ]; then install -m 755 "$self" "$SELF_DST"; fi
  mkdir -p "$STATE"; chmod 700 "$STATE"
  take_lock
  shred_export   # بقايا تشغيل سابق انقطع
  if [ "$resume" = 1 ]; then
    caddy_switch supabase || die "تعذّر تثبيت إعداد Supabase في Caddy قبل إعادة النقل؛ لم يتغير شيء"
    rm -f -- "$BACKEND_FLAG" "$ETC/switch-pending"
  fi
  if [ "$mode" = live ] && [ ! -f "$ETC/backend-was-live" ]; then
    # الموقع عمل على هذه القاعدة (تحويل سابق انقطع قبل أن يكتب العلامة): لا يستبدلها نقل لاحق دون --replace
    date -u +%FT%TZ > "$ETC/backend-was-live"
  fi

  say "١/٦ تنزيل خادم البيانات (PostgREST) وخادم الدخول (GoTrue)…"
  install_backend_binaries
  ensure_api_user
  load_secrets

  say "٢/٦ تجهيز قاعدة $DB على PostgreSQL في السيرفر…"
  pg_checks
  # نسخ من تشغيل سابق انقطع (فيها بيانات المشرفين)؛ لا تلزم بين تشغيل وآخر،
  # والقديمة منها محفوظة في النسخة الاحتياطية التي سبقت الاستبدال
  drop_db "${DB}_new"
  drop_db "${DB}_old"
  case $mode in
    live)
      db_utf8_or_die
      db_has_data || die "الموقع مضبوط على قاعدة السيرفر لكن قاعدة $DB مفقودة أو فارغة؛ لم أنشئ قاعدة فارغة مكانها.
$(restore_hint)" ;;
    reattach)
      db_utf8_or_die
      db_has_data || die "لا توجد بيانات في قاعدة السيرفر.
$(restore_hint)
أو للنقل من جديد من Supabase: sudo dalil-hama-site install-db --replace" ;;
    transfer)
      if db_has_data && [ -f "$ETC/backend-was-live" ] && [ "$replace" != 1 ]; then
        die "قاعدة السيرفر عمل عليها الموقع من قبل؛ لن أستبدلها. للنقل من جديد من Supabase: sudo dalil-hama-site install-db --replace"
      fi ;;
  esac
  # المخطط وواجهة الموقع من الإصدار نفسه: آخر إصدار في الفرع إن كان سليماً، وإلا الإصدار المعروض
  rel=
  if [ ! -f "$BASE/PINNED" ]; then rel=$(remote_sha) || rel=; fi
  if [ -n "$rel" ] && [ -f "$BASE/bad-$rel" ]; then
    warn "آخر إصدار (${rel:0:7}) مرفوض: $(cat "$BASE/bad-$rel")؛ أبقيت الإصدار الحالي"
    rel=
  fi
  if [ -n "$rel" ]; then
    # يُجرَّب في عملية فرعية: إصدار مرفوض لا يوقف الأمر بل يبقى الإصدار الحالي
    set +e; ( set -e; fetch_release "$rel" ) 2>"$STATE/fetch.log"; a=$?; set -e
    if [ "$a" != 0 ]; then
      a=$(sed -n 's/^✗ //p' "$STATE/fetch.log" | head -n 1)
      warn "${a%؛ الموقع باقٍ على الإصدار الحالي}؛ أبقيت الإصدار الحالي"
      rel=
    fi
  fi
  if [ -z "$rel" ]; then
    rel=$(current_sha) || die "لا يوجد إصدار مثبّت من الموقع"
    fetch_release "$rel"
  fi
  if [ "$mode" = transfer ]; then
    say "٣/٦ نقل البيانات من Supabase (لا تعدّل شيئاً في لوحة الإدارة حتى ينتهي)…"
    fetch_export "$token"
    build_new_db "$rel"
    # ما على قاعدة السيرفر الحالية يُحفظ دائماً قبل أن تحل محلها النسخة المنقولة
    if db_has_data; then
      say "  حفظ قاعدة السيرفر الحالية قبل أن تحل محلها النسخة المنقولة:"
      ( BACKUP_TAG=before-replace cmd_backup ) || die "تعذّرت النسخة الاحتياطية من قاعدة السيرفر الحالية؛ لم يتغير شيء"
    fi
    swap_in_new_db
    shred_export
    ok "نُقلت البيانات ($EXPORT_APPROVED نشاطاً منشوراً)"
  else
    db_bootstrap
    gotrue_migrate
    db_owner_grants
    app_migrations "$rel"
    say "٣/٦ البيانات على السيرفر كما هي (لا نقل جديد)."
    if [ "$mode" = reattach ]; then
      warn "ما أُضيف في Supabase منذ db-rollback لا يُنقل. لنقله مع كل البيانات: sudo dalil-hama-site install-db --replace"
    fi
  fi
  pg -d "$DB" -Atc "select name from dh_meta.migrations order by 1" | LC_ALL=C sort > "$ETC/applied-migrations"
  chmod 644 "$ETC/applied-migrations"
  if [ "$rel" != "$(current_sha || true)" ]; then
    activate "$rel"
    printf '%s\n' "$rel" > "$BASE/last-checked"
    prune
  fi
  rm -f -- "$BASE/.last-error"
  fix_owner

  say "٤/٦ تشغيل خدمات قاعدة البيانات…"
  write_backend_configs
  start_backend

  if [ "$mode" = live ]; then
    write_override
    caddy_switch local || die "رفض Caddy إعداد الموقع المحدّث؛ بقي كما كان"
    backend_serving || die "الموقع لا يقرأ من قاعدة السيرفر كما يجب؛ راجع: sudo dalil-hama-site status"
    if [ -f "$ETC/switch-pending" ]; then
      warn "النقل السابق انقطع بعد تحويل الموقع؛ ما أُضيف في Supabase بعد $(cat "$ETC/switch-pending") ليس على السيرفر"
      rm -f -- "$ETC/switch-pending"
    fi
    install_backup_units
    if [ -z "$(find "$BACKUP_DIR" -maxdepth 1 -name "$DB-*.dump" 2>/dev/null | head -n 1)" ]; then
      ( QUIET=1 cmd_backup ) || warn "تعذّرت النسخة الاحتياطية؛ جرّب: sudo dalil-hama-site backup"
    fi
    fix_owner
    ok "قاعدة السيرفر وخدماتها محدّثة، والبيانات كما هي."
    return 0
  fi
  if [ "$mode" = reattach ]; then
    EXPORT_APPROVED=$(pg -d "$DB" -Atc "select count(*) from public.listings where status = 'approved'")
  fi

  say "٥/٦ تحويل الموقع إلى قاعدة السيرفر…"
  [ -f "$ETC/backend-was-live" ] && had_marker=1
  # الرجوع إلى Supabase: العلامات تُحذف فقط إن تحوّل Caddy فعلاً، وإلا تبقى الحالة «السيرفر» كما هي في الواقع.
  # وبعد أن وصل الزوار إلى قاعدة السيرفر (switched=1) تبقى علامة backend-was-live كي لا يستبدلها نقل لاحق دون نسخة احتياطية
  switch_back() {
    caddy_switch supabase || return 1
    rm -f -- "$BACKEND_FLAG" "$ETC/switch-pending"
    if [ "$had_marker" = 0 ] && [ "$switched" = 0 ]; then rm -f -- "$ETC/backend-was-live"; fi
  }
  switch_abort() {
    trap '' INT TERM HUP   # إشارة ثانية لا تقطع الرجوع في منتصفه
    if switch_back >/dev/null 2>&1; then warn "قُطع الأمر فأعدت الموقع إلى Supabase"
    else warn "قُطع الأمر والموقع قد يقرأ من قاعدة السيرفر؛ راجع: sudo dalil-hama-site status (للرجوع: sudo dalil-hama-site db-rollback)"; fi
    exit 130
  }
  trap switch_abort INT TERM HUP
  write_override force
  fix_owner
  # العلامات قبل Caddy: إن انقطع الأمر بعد التحويل، يُكمله تشغيله من جديد ولا يستبدل نقلٌ لاحق ما كُتب على السيرفر؛
  # وswitch-pending تبقى حتى يثبت أن الموقع يقرأ من السيرفر (وإلا يُعاد النقل بنسخة جديدة)
  touch "$BACKEND_FLAG"
  date -u '+%F %H:%M UTC' > "$ETC/switch-pending"
  date -u +%FT%TZ > "$ETC/backend-was-live"
  switched=1
  if ! caddy_switch local; then
    # Caddy رفض الإعداد فبقي على ما كان (Supabase): لم يصل أحد إلى قاعدة السيرفر
    switched=0
    rm -f -- "$BACKEND_FLAG" "$ETC/switch-pending"
    if [ "$had_marker" = 0 ]; then rm -f -- "$ETC/backend-was-live"; fi
    trap - INT TERM HUP
    die "تعذّر تحويل Caddy؛ الموقع ما زال يقرأ من Supabase كما كان"
  fi
  if ! backend_serving "$EXPORT_APPROVED"; then
    if switch_back; then
      trap - INT TERM HUP
      die "الموقع لم يقرأ من قاعدة السيرفر كما يجب فأعدته إلى Supabase. راجع: sudo dalil-hama-site status ثم أعد النقل: sudo dalil-hama-site install-db --replace (يحفظ ما كُتب على السيرفر في نسخة احتياطية أولاً)"
    fi
    trap - INT TERM HUP
    die "الموقع لم يقرأ من قاعدة السيرفر كما يجب، وتعذّرت إعادته إلى Supabase فبقي على قاعدة السيرفر. راجع: sudo dalil-hama-site status (للرجوع: sudo dalil-hama-site db-rollback)"
  fi
  rm -f -- "$ETC/switch-pending"
  trap - INT TERM HUP
  ok "الموقع يقرأ الآن من قاعدة السيرفر"

  say "٦/٦ النسخ الاحتياطي الليلي…"
  install_backup_units
  ( QUIET=1 cmd_backup ) || warn "تعذّرت النسخة الاحتياطية الأولى؛ جرّب: sudo dalil-hama-site backup"

  say ""
  ok "تم. بيانات دليل حماة الآن على سيرفركم (PostgreSQL، قاعدة $DB)."
  say "  • أغلق أي تبويب للوحة الإدارة أو للدليل كان مفتوحاً قبل النقل وافتحه من جديد؛ التبويب القديم يبقى على Supabase."
  say "  • لوحة الإدارة تعمل بالبريد وكلمة المرور نفسيهما."
  say "  • نسخة احتياطية كل ليلة في $BACKUP_DIR (تُحفظ 14 يوماً)."
  say "  • للرجوع إلى Supabase عند الحاجة:  sudo dalil-hama-site db-rollback"
}

cmd_backup() {
  [ "${1:-}" = --quiet ] && QUIET=1
  need_root backup
  db_exists || die "لا توجد قاعدة $DB على هذا السيرفر"
  mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"
  local out
  # بقايا نسخ انقطعت (أقدم من ساعة، فلا تمس نسخة جارية الآن)
  find "$BACKUP_DIR" -maxdepth 1 -name "$DB-*.dump.tmp" -mmin +60 -delete 2>/dev/null || true
  out=$BACKUP_DIR/$DB-${BACKUP_TAG:+$BACKUP_TAG-}$(date -u +%Y%m%d-%H%M%S).dump
  runuser -u postgres -- pg_dump -Fc "$DB" > "$out.tmp" || { rm -f -- "$out.tmp"; die "فشل النسخ الاحتياطي"; }
  [ "$(stat -c%s "$out.tmp")" -gt 2000 ] || { rm -f -- "$out.tmp"; die "النسخة الاحتياطية صغيرة على نحو غير طبيعي؛ لم تُحفظ"; }
  chmod 600 "$out.tmp"; mv -f -- "$out.tmp" "$out"
  # التدوير للنسخ الليلية فقط؛ نسخ ما قبل الاستبدال أو الاسترجاع (before-*) تبقى
  find "$BACKUP_DIR" -maxdepth 1 -name "$DB-2*.dump" -mtime +14 -delete
  ok "نسخة احتياطية: $out ($(du -h "$out" | cut -f1))"
}

cmd_db_rollback() {
  need_root db-rollback
  detect_caddy
  take_lock
  # الإعداد قد يبقى موجَّهاً إلى السيرفر دون العلامة (رجوع سابق انقطع بإصدار أقدم من هذا الأمر)
  [ -f "$BACKEND_FLAG" ] || grep -q 'handle_path /rest/v1/' "$SITE_CONF" 2>/dev/null || site_on_server ||
    die "الموقع يقرأ من Supabase أصلاً"
  # العلامة تُحذف بعد نجاح التحويل فقط: انقطاع الأمر يترك الحالة «السيرفر» ويكفي تكراره
  caddy_switch supabase || die "تعذّر تفعيل الإعداد؛ بقي الموقع على قاعدة السيرفر"
  rm -f -- "$BACKEND_FLAG" "$ETC/switch-pending"
  ok "عاد الموقع إلى قراءة البيانات من Supabase."
  warn "ما أُضيف أو عُدّل على قاعدة السيرفر منذ النقل ليس في Supabase. قاعدة السيرفر باقية كما هي."
  say "  للعودة إلى قاعدة السيرفر كما هي:  sudo dalil-hama-site install-db"
  say "  أو لنقل جديد من Supabase يشمل ما يُضاف فيها من الآن (مع نسخة احتياطية من قاعدة السيرفر أولاً):"
  say "                                    sudo dalil-hama-site install-db --replace"
}

# استرجاع نسخة احتياطية في قاعدة مؤقتة ثم وضعها مكان القاعدة الحالية دفعة واحدة؛
# الأدوار تُنشأ أولاً (عنقود PostgreSQL أُعيد إنشاؤه لا يحويها)
cmd_db_restore() {
  need_root db-restore
  need_tools psql pg_restore pg_dump runuser flock python3
  local file=${1:-} n new=${DB}_new
  systemctl is-active --quiet postgresql || die "PostgreSQL لا يعمل على هذا السيرفر"
  mkdir -p "$STATE"; chmod 700 "$STATE"
  take_lock
  if [ -z "$file" ]; then file=$(ls -1t -- "$BACKUP_DIR/$DB-"*.dump 2>/dev/null | head -n 1) || file=; fi
  [ -n "$file" ] && [ -f "$file" ] || die "لا توجد نسخة احتياطية في $BACKUP_DIR"
  load_secrets
  pg_checks
  db_roles
  drop_db "$new"
  pg -c "set client_min_messages = warning" \
     -c "create database $new owner dalil_owner encoding 'UTF8' lc_collate 'C.UTF-8' lc_ctype 'C.UTF-8' template template0" \
     -c "revoke all on database $new from public" \
     -c "grant connect, temporary on database $new to authenticator, supabase_auth_admin" >/dev/null
  say "استرجاع ${file##*/}…"
  if ! runuser -u postgres -- pg_restore --exit-on-error -d "$new" < "$file" 2>"$STATE/restore.log"; then
    tail -n 5 "$STATE/restore.log" >&2
    drop_db "$new"
    die "تعذّر استرجاع ${file##*/}؛ لم يتغير شيء"
  fi
  n=$(pg -d "$new" -Atc "select count(*) from public.listings" 2>/dev/null) || n=0
  if [ "${n:-0}" -le 0 ]; then drop_db "$new"; die "النسخة ${file##*/} لا تحوي أنشطة؛ لم يتغير شيء"; fi
  if db_has_data; then
    say "  حفظ القاعدة الحالية قبل أن تحل محلها النسخة المسترجعة:"
    ( BACKUP_TAG=before-restore cmd_backup ) || { drop_db "$new"; die "تعذّرت النسخة الاحتياطية من القاعدة الحالية؛ لم يتغير شيء"; }
  fi
  swap_in_new_db
  ok "استُرجعت ${file##*/} ($n نشاطاً)"
  if [ -f "$BACKEND_FLAG" ]; then
    # تشغيل الخدمات على القاعدة المسترجعة والتحقق أن الموقع يقرأ منها
    cmd_install_db
  else
    say "  الموقع يقرأ من Supabase الآن؛ للعودة إلى قاعدة السيرفر:  sudo dalil-hama-site install-db"
  fi
}

unit_state() {
  local st
  st=$(systemctl is-active "$1" 2>/dev/null) || true
  case $st in
    active) echo "يعمل" ;;
    inactive) echo "متوقف" ;;
    failed) echo "متعطّل" ;;
    activating|reloading) echo "يبدأ" ;;
    '') echo "غير معروف" ;;
    *) echo "$st" ;;
  esac
}

cmd_status() {
  load_conf
  local cur served remote note=
  cur=$(current_sha) || cur=
  served=$(served_sha) || served=
  remote=$(remote_sha) || remote=
  if [ -n "$remote" ] && [ "$remote" != "$cur" ]; then
    if [ -f "$BASE/bad-$remote" ]; then note=" (مرفوض: $(cat "$BASE/bad-$remote"))"
    elif [ -n "$(missing_migrations "$remote" | tr -d ' ')" ]; then note=" (ينتظر تحديث قاعدة البيانات: sudo dalil-hama-site install-db)"
    elif [ "$remote" = "$(cat "$BASE/last-checked" 2>/dev/null || true)" ]; then note=" (لا تغيير في ملفات الموقع)"
    else note=" (يُطبَّق خلال 10 دقائق)"; fi
  fi
  say "النطاق:            https://$HOST"
  say "المصدر:            github.com/$REPO ($BRANCH)"
  say "الإصدار المثبّت:    ${cur:0:7}"
  if [ -n "$served" ]; then say "الإصدار المعروض:    ${served:0:7}"
  else say "الإصدار المعروض:    — (النطاق لا يعرض الموقع الجديد)"; fi
  if [ -n "$remote" ]; then say "آخر إصدار متاح:     ${remote:0:7}$note"
  else say "آخر إصدار متاح:     — (تعذّر الوصول إلى GitHub)"; fi
  if [ -f "$BASE/PINNED" ]; then say "التحديث التلقائي:   موقوف (sudo dalil-hama-site resume)"
  else say "التحديث التلقائي:   $(unit_state "$UNIT.timer")"; fi
  if [ -s "$BASE/.last-error" ]; then say "آخر خطأ في التحديث:  $(cat "$BASE/.last-error")"; fi
  say "الموقع القديم:      $(unit_state dalil-hama)"
  local on_server=0
  if [ -n "$served" ] && site_on_server; then on_server=1; fi
  if [ -f "$BACKEND_FLAG" ]; then
    local n last
    n=$(pg -d "$DB" -Atc "select count(*) from public.listings where status = 'approved'" 2>/dev/null) || n="؟"
    last=$( { find "$BACKUP_DIR" -maxdepth 1 -name "$DB-*.dump" -printf '%TY-%Tm-%Td %TH:%TM\n' 2>/dev/null || true; } | sort | tail -n 1)
    say "قاعدة البيانات:     السيرفر ($DB، $n نشاطاً منشوراً)"
    if [ -n "$served" ] && [ "$on_server" = 0 ]; then
      say "  ! لكن الموقع لا يقرأ منها الآن (تحويل لم يكتمل): sudo dalil-hama-site install-db"
    fi
    say "خدمة البيانات:      $(unit_state dalil-hama-api)    خدمة الدخول: $(unit_state dalil-hama-auth)"
    say "آخر نسخة احتياطية:  ${last:-لا يوجد}"
  else
    say "قاعدة البيانات:     Supabase"
    if [ "$on_server" = 1 ]; then
      say "  ! لكن الموقع ما زال يقرأ من قاعدة السيرفر: sudo dalil-hama-site db-rollback"
    fi
  fi
}

usage() {
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "${BASH_SOURCE[0]}"
}

case ${1:-} in
  install)  cmd_install ;;
  update)   shift; cmd_update "$@" ;;
  previous) cmd_previous ;;
  resume)   cmd_resume ;;
  rollback) cmd_rollback ;;
  status)   cmd_status ;;
  install-db)  shift; cmd_install_db "$@" ;;
  backup)      shift; cmd_backup "$@" ;;
  db-restore)  shift; cmd_db_restore "$@" ;;
  db-rollback) cmd_db_rollback ;;
  *)        usage; exit 2 ;;
esac
