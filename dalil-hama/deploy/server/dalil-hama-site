load_secrets() {
  local f=$ETC/backend.env
  mkdir -p "$ETC"; chmod 755 "$ETC"
  if [ ! -s "$f" ]; then
    python3 -c 'import secrets
print("JWT_SECRET=" + secrets.token_hex(32)); print("PW_API=" + secrets.token_hex(24)); print("PW_AUTH=" + secrets.token_hex(24))' > "$f.new"
    chmod 600 "$f.new"; mv -f -- "$f.new" "$f"
  fi
  chmod 600 "$f"; chown root:root "$f"
