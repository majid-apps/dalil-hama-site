SQL
}

db_bootstrap() {
  db_roles
  pg -v db="$DB" -f - >/dev/null <<'SQL'
set client_min_messages = warning;
-- UTF8 صراحةً: عناقيد PostgreSQL المهيّأة بلغة C تكون SQL_ASCII، فتُعدّ الحروف العربية بالبايت
select format('create database %I owner dalil_owner encoding ''UTF8'' lc_collate ''C.UTF-8'' lc_ctype ''C.UTF-8'' template template0', :'db')
 where not exists (select from pg_database where datname = :'db') \gexec
\connect :db
set client_min_messages = warning;
revoke all on database :"db" from public;
grant connect, temporary on database :"db" to authenticator, supabase_auth_admin;
create schema if not exists auth authorization supabase_auth_admin;
create schema if not exists extensions;
create extension if not exists pgcrypto with schema extensions;
create schema if not exists dh_meta authorization dalil_owner;
grant usage on schema extensions to anon, authenticated, service_role, supabase_auth_admin, dalil_owner;
grant usage on schema auth to anon, authenticated, service_role, dalil_owner;
grant usage on schema public to anon, authenticated, service_role;
create table if not exists dh_meta.migrations (name text primary key, applied_at timestamptz not null default now());
alter table dh_meta.migrations owner to dalil_owner;
SQL
  local who pw hba
  for who in authenticator supabase_auth_admin; do
    if [ "$who" = authenticator ]; then pw=$PW_API; else pw=$PW_AUTH; fi
    if ! PGPASSWORD=$pw psql -X -q -h 127.0.0.1 -p "$PG_PORT" -U "$who" -d "$DB" -Atc 'select 1' >/dev/null 2>&1; then
      hba=$(pg -Atc 'show hba_file' 2>/dev/null) || hba=pg_hba.conf
      # أول سطر يطابق في pg_hba هو المعتمد، فلا يكفي إلحاق السطر في آخر الملف
      die "PostgreSQL يرفض دخول $who بكلمة مرور من 127.0.0.1. أضف هذا السطر في $hba فوق أسطر host الأخرى:
  $HBA_LINE
ثم: sudo systemctl reload postgresql وأعد الأمر"
    fi
  done
}

