# مسارات قاعدة البيانات على السيرفر (بعد النقل فقط): البيانات والدخول على النطاق نفسه،
# وconfig.js بديل يوجّه الواجهة إليها بدل Supabase
# (ترويسة CF-Connecting-IP يضعها الزائر نفسه هنا، لا Cloudflare، فتُحذف كي لا يتجاوز حدود الطلبات بها)
# ROUTES=local|supabase يحدد الوجهة صراحةً (caddy_switch)؛ دونه تُتبع علامة backend-local
api_routes() {
  case ${ROUTES:-} in
    local) ;;
    supabase) return 0 ;;
    *) [ -f "$BACKEND_FLAG" ] || return 0 ;;
  esac
  cat <<EOF

	handle_path /rest/v1/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy 127.0.0.1:$API_PORT {
			header_up -Cf-Connecting-Ip
		}
	}
	handle_path /auth/v1/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:$AUTH_PORT {
			header_up -Cf-Connecting-Ip
		}
	}
	handle /assets/js/config.js {
		root * $OVERRIDE
		file_server
	}
EOF
}

write_site_conf() {
  local addresses=$1 tmp=$SITE_CONF.new
  mkdir -p "$ETC"; chmod 755 "$ETC"
  cat > "$tmp" <<EOF
# دليل حماة — الموقع الجديد (ملفات ثابتة من $BASE/current).
# يكتب هذا الملفَّ الأمرُ dalil-hama-site عند كل تثبيت؛ أي تعديل يدوي هنا يُستبدل.
$addresses {
	root * $BASE/current
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(self), microphone=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://cdnjs.cloudflare.com; font-src 'self'; connect-src 'self' https://jhgwzynxkioqfyoldoyx.supabase.co; manifest-src 'self'; worker-src 'self'; frame-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
		-Server
	}

	@revalidate path / /index.html /admin/ /admin/index.html /privacy/ /privacy/index.html /sw.js /manifest.webmanifest /release.txt /robots.txt /sitemap.xml *.js *.css
	header @revalidate Cache-Control "no-cache"
	@fonts path /assets/fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"
	@images path /assets/img/* /favicon.svg
	header @images Cache-Control "public, max-age=86400"
	header /manifest.webmanifest Content-Type "application/manifest+json"

	redir /admin /admin/ 308
	redir /privacy /privacy/ 301
	respond /health "ok" 200
$(api_routes)
	file_server

	handle_errors {
		@missing_page {
			expression {err.status_code} == 404
			path_regexp ^/[^.]*$
		}
		redir @missing_page / 302
		respond "{err.status_code} {err.status_text}"
	}
}
EOF
  chmod 644 "$tmp"
  mv -f "$tmp" "$SITE_CONF"
}

