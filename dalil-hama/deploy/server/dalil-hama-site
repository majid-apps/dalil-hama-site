# تنزيل ملف رسمي والتحقق من بصمته قبل أي استخدام
fetch_verified() {
  if [ -n "${DH_DOWNLOAD_DIR:-}" ]; then cp -- "$DH_DOWNLOAD_DIR/${1##*/}" "$3"
  else curl -fsSL --retry 3 --retry-delay 3 --connect-timeout 20 --max-time 600 -o "$3" "$1" || die "تعذّر تنزيل ${1##*/}"; fi
  [ "$(sha256sum "$3" | cut -d' ' -f1)" = "$2" ] || die "بصمة ${1##*/} لا تطابق النسخة الرسمية؛ لم يتغير شيء"
}

install_backend_binaries() {
  local gh=https://github.com pg_url pg_sha au_url au_sha
  case $(uname -m) in
    x86_64|amd64)
      pg_url=$gh/PostgREST/postgrest/releases/download/$PGRST_VERSION/postgrest-$PGRST_VERSION-linux-static-x86-64.tar.xz
      au_url=$gh/supabase/auth/releases/download/$AUTH_VERSION/auth-$AUTH_VERSION-x86.tar.gz
      pg_sha=$PGRST_SHA_X86; au_sha=$AUTH_SHA_X86 ;;
    aarch64|arm64)
      pg_url=$gh/PostgREST/postgrest/releases/download/$PGRST_VERSION/postgrest-$PGRST_VERSION-ubuntu-aarch64.tar.xz
      au_url=$gh/supabase/auth/releases/download/$AUTH_VERSION/auth-$AUTH_VERSION-arm64.tar.gz
      pg_sha=$PGRST_SHA_ARM; au_sha=$AUTH_SHA_ARM ;;
    *) die "معالج السيرفر ($(uname -m)) غير مدعوم" ;;
  esac
  mkdir -p "$OPT"; chmod 755 "$OPT"
  # بقايا تنزيل انقطع؛ القفل بأيدينا فلا تنزيل آخر جارٍ
  rm -rf -- "$OPT"/.tmp.*
  if [ ! -x "$OPT/postgrest-$PGRST_VERSION/postgrest" ]; then
    TMP=$(mktemp -d "$OPT/.tmp.XXXXXX")
    fetch_verified "$pg_url" "$pg_sha" "$TMP/p.tar.xz"
    mkdir "$TMP/p"; tar -xJf "$TMP/p.tar.xz" -C "$TMP/p" --no-same-owner postgrest
    chmod 755 "$TMP/p" "$TMP/p/postgrest"
    mv -T "$TMP/p" "$OPT/postgrest-$PGRST_VERSION"; rm -rf -- "$TMP"; TMP=
  fi
  if [ ! -x "$OPT/auth-$AUTH_VERSION/auth" ]; then
    TMP=$(mktemp -d "$OPT/.tmp.XXXXXX")
    fetch_verified "$au_url" "$au_sha" "$TMP/a.tar.gz"
    mkdir "$TMP/a"; tar -xzf "$TMP/a.tar.gz" -C "$TMP/a" --no-same-owner --no-same-permissions auth migrations
    find "$TMP/a" -type d -exec chmod 755 {} +; find "$TMP/a" -type f -exec chmod 644 {} +; chmod 755 "$TMP/a/auth"
    mv -T "$TMP/a" "$OPT/auth-$AUTH_VERSION"; rm -rf -- "$TMP"; TMP=
  fi
}

