start_backend() {
  local p u
  for p in "$API_PORT:dalil-hama-api" "$AUTH_PORT:dalil-hama-auth"; do
    u=${p#*:}
    if port_in_use "${p%%:*}" && ! systemctl is-active --quiet "$u"; then
      die "المنفذ ${p%%:*} مشغول ببرنامج آخر على السيرفر؛ لم يتغير شيء في الموقع"
    fi
  done
  backend_unit dalil-hama-api "Dalil Hama: data API (PostgREST)" "$OPT/postgrest-$PGRST_VERSION/postgrest $ETC/postgrest.conf"
  backend_unit dalil-hama-auth "Dalil Hama: admin sign-in (GoTrue)" "$OPT/auth-$AUTH_VERSION/auth serve" \
    "EnvironmentFile=$ETC/auth.env
WorkingDirectory=$OPT/auth-$AUTH_VERSION"
  systemctl daemon-reload
  systemctl enable dalil-hama-api dalil-hama-auth >/dev/null 2>&1 || true
  systemctl restart dalil-hama-api dalil-hama-auth || die "تعذّر تشغيل خدمات قاعدة البيانات؛ راجع: journalctl -u dalil-hama-api -u dalil-hama-auth"
  local until=$((SECONDS + 40))
  while [ "$SECONDS" -lt "$until" ]; do
    if curl -fsS --noproxy '*' --max-time 3 -X POST -H 'content-type: application/json' -d '{}' \
         "http://127.0.0.1:$API_PORT/rpc/sync" >/dev/null 2>&1 &&
       curl -fsS --noproxy '*' --max-time 3 "http://127.0.0.1:$AUTH_PORT/health" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  die "خدمات قاعدة البيانات لم تستجب؛ راجع: journalctl -u dalil-hama-api -u dalil-hama-auth"
}

# نسخة البيانات من Supabase عبر دالة التصدير المؤقتة المحمية بمفتاح النقل
fetch_export() {
  local out=$STATE/export.json
  rm -f -- "$out"
  EXPORT_LEFT=1
  if [ -n "${DH_EXPORT_FILE:-}" ]; then cp -- "$DH_EXPORT_FILE" "$out"
  else
    printf '{"p_token":"%s"}' "$1" | curl -fsS --compressed --connect-timeout 20 --max-time 180 -X POST \
      -H "apikey: $SUPABASE_KEY" -H 'content-type: application/json' --data-binary @- \
      -o "$out" "$SUPABASE_URL/rest/v1/rpc/dh_server_export" || die "تعذّر الاتصال بـ Supabase لنقل البيانات"
  fi
  chmod 600 "$out"
  EXPORT_APPROVED=$(python3 - "$out" "$STATE/export.line" <<'PY'
import json, sys
d = json.load(open(sys.argv[1], encoding='utf-8'))
if not isinstance(d, dict) or d.get('format') != 1 or not d.get('listings') or not d.get('admins'):
    sys.exit(1)
open(sys.argv[2], 'w', encoding='utf-8').write(json.dumps(d, ensure_ascii=False, separators=(',', ':')))
print(sum(1 for l in d['listings'] if l.get('status') == 'approved'))
PY
) || die "مفتاح النقل غير صحيح أو انتهت صلاحيته؛ لم يتغير شيء في الموقع"
  chmod 600 "$STATE/export.line"
}

import_export() {
  {
    cat <<'SQL'
\set ON_ERROR_STOP on
begin;
set local session_replication_role = replica;
create temp table imp (j jsonb) on commit drop;
copy imp from stdin with (format csv, quote e'\x01', delimiter e'\x02');
SQL
    cat -- "$STATE/export.line"
    printf '\n\\.\n'
    cat <<'SQL'
create function pg_temp.load(tbl regclass, data jsonb) returns integer language plpgsql as $$
declare cols text; n integer;
begin
  if data is null or jsonb_array_length(data) = 0 then return 0; end if;
  select string_agg(quote_ident(a.attname), ', ' order by a.attnum) into cols
    from pg_attribute a
   where a.attrelid = tbl and a.attnum > 0 and not a.attisdropped and a.attgenerated = ''
     and (data -> 0) ? a.attname;
  execute format('insert into %s (%s) select %s from jsonb_populate_recordset(null::%s, $1)', tbl, cols, cols, tbl) using data;
  get diagnostics n = row_count;
  return n;
end $$;

do $$
declare d jsonb := (select j from imp); r record; got integer; want integer;
begin
  if exists (select 1 from public.listings) then raise exception 'server database already has data; refusing to overwrite'; end if;
  delete from public.settings;
  for r in select * from (values
      (1, 'auth.users', 'users'), (2, 'auth.identities', 'identities'),
      (3, 'public.categories', 'categories'), (4, 'public.areas', 'areas'),
      (5, 'public.listings', 'listings'), (6, 'public.listing_stats', 'listing_stats'),
      (7, 'public.reports', 'reports'), (8, 'public.settings', 'settings'),
      (9, 'public.admins', 'admins'), (10, 'public.daily_stats', 'daily_stats'),
      (11, 'public.search_terms', 'search_terms'), (12, 'public.audit_log', 'audit_log'),
      (13, 'private.tombstones', 'tombstones'), (14, 'private.track_seen', 'track_seen')) v(o, tbl, key) order by o
  loop
    got := pg_temp.load(r.tbl::regclass, d -> r.key);
    want := coalesce(jsonb_array_length(d -> r.key), 0);
    if got <> want then raise exception '% rows: got % expected %', r.tbl, got, want; end if;
  end loop;
  perform setval(pg_get_serial_sequence('public.categories', 'id'), greatest((select max(id) from public.categories), (d #>> '{sequences,categories}')::bigint, 1));
  perform setval(pg_get_serial_sequence('public.areas', 'id'), greatest((select max(id) from public.areas), (d #>> '{sequences,areas}')::bigint, 1));
  perform setval(pg_get_serial_sequence('public.listings', 'id'), greatest((select max(id) from public.listings), (d #>> '{sequences,listings}')::bigint, 1000000));
  perform setval(pg_get_serial_sequence('public.reports', 'id'), greatest((select max(id) from public.reports), (d #>> '{sequences,reports}')::bigint, 1));
  perform setval(pg_get_serial_sequence('public.audit_log', 'id'), greatest((select max(id) from public.audit_log), (d #>> '{sequences,audit_log}')::bigint, 1));
end $$;
commit;
SQL
  } | pg -d "$DB" -f - >"$STATE/import.log" 2>&1 || { tail -n 5 "$STATE/import.log" >&2; die "فشل استيراد البيانات إلى قاعدة السيرفر؛ لم يتغير شيء"; }
}

