#!/usr/bin/env bash
# دليل حماة — تشغيل الموقع الجديد على سيرفر majid.cfd خلف Caddy، مع تحديث تلقائي ورجوع فوري.
#
# أول مرة، على السيرفر:
#   curl -fsSL <رابط هذا الملف> -o /tmp/dalil-hama-site && sudo bash /tmp/dalil-hama-site install
#
# بعد التثبيت:
#   sudo dalil-hama-site status     حالة الموقع والتحديث
#   sudo dalil-hama-site update     جلب آخر إصدار الآن (يجري تلقائياً كل 10 دقائق)
#   sudo dalil-hama-site previous   الرجوع إلى الإصدار السابق وإيقاف التحديث التلقائي
#   sudo dalil-hama-site resume     استئناف التحديث التلقائي
#   sudo dalil-hama-site rollback   إعادة النطاق إلى الموقع القديم فوراً
#
# قاعدة البيانات على السيرفر نفسه (PostgreSQL المحلي، مع PostgREST للبيانات وGoTrue لدخول المشرفين):
#   sudo dalil-hama-site install-db                 أول مرة: يطلب مفتاح النقل، ثم ينقل البيانات من Supabase ويحوّل الموقع إليها
#   sudo dalil-hama-site install-db                 بعد النقل: تحديث الخدمات والمخطط (لا يمس البيانات)
#   sudo dalil-hama-site install-db --replace       نقل جديد من Supabase يحل محل قاعدة السيرفر (بعد db-rollback، مع نسخة احتياطية قبله)
#   sudo dalil-hama-site backup                     نسخة احتياطية الآن (تجري تلقائياً كل ليلة)
#   sudo dalil-hama-site db-restore [FILE]          استرجاع آخر نسخة احتياطية (أو FILE) مكان قاعدة السيرفر
#   sudo dalil-hama-site db-rollback                إعادة الموقع إلى Supabase
#
# لا يمس هذا الأمر الموقعَ القديم (خدمة dalil-hama وقاعدة بياناتها dalil) ولا مواقع Caddy الأخرى:
# يستبدل كتلة dalil-hama.majid.cfd وحدها بسطر import، ويحفظ نسخة منها لإعادتها عند الرجوع.
