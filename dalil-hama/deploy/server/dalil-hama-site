gotrue_migrate() {
  # المتغيرات تُمرَّر إلى env كما هي، دون أن تمر على الصدفة (في رابط القاعدة & وفي القائمة **)
  local -a vars=()
  local line
  while IFS= read -r line; do vars+=("$line"); done < <(gotrue_env)
  (cd "$OPT/auth-$AUTH_VERSION" && env -i PATH=/usr/bin:/bin "${vars[@]}" ./auth migrate) \
    >"$STATE/auth-migrate.log" 2>&1 || { tail -n 5 "$STATE/auth-migrate.log" >&2; die "فشل تجهيز جداول الدخول (GoTrue)"; }
}

# ما تحتاجه دوال الدليل من جداول الدخول: إنشاء المشرفين (admin_create_user) وربط جدول admins
db_owner_grants() {
  pg -d "$DB" -f - >/dev/null <<'SQL'
grant select, insert, update, references on auth.users to dalil_owner;
grant select, insert on auth.identities to dalil_owner;
grant select, update on auth.refresh_tokens to dalil_owner;
SQL
}

# مخطط الدليل من مجلد supabase/migrations في الإصدار المعروض نفسه؛ كل ملف يُطبَّق مرة واحدة
app_migrations() {
  local sha=$1 f name
  rm -rf -- "$STATE"/.tmp.*
  TMP=$(mktemp -d "$STATE/.tmp.XXXXXX")
  if [ -n "${DH_SOURCE_TARBALL:-}" ]; then cp -- "$DH_SOURCE_TARBALL" "$TMP/src.tgz"
  else curl -fsSL --retry 3 --retry-delay 3 --connect-timeout 20 --max-time 300 -o "$TMP/src.tgz" \
         "https://codeload.github.com/$REPO/tar.gz/$sha" || die "تعذّر تنزيل مخطط قاعدة البيانات"; fi
  mkdir "$TMP/m"
  tar -xzf "$TMP/src.tgz" -C "$TMP/m" --no-same-owner --wildcards --strip-components=4 \
      "*/dalil-hama/supabase/migrations/*.sql" 2>/dev/null || die "لم أجد ملفات مخطط قاعدة البيانات في الإصدار"
  chmod -R a+rX "$TMP"
  for f in "$TMP"/m/*.sql; do
    name=${f##*/}
    [[ $name =~ ^[0-9A-Za-z_.-]+\.sql$ ]] || die "اسم ملف مخطط غير مألوف: $name"
    [ "$(pg -d "$DB" -Atc "select count(*) from dh_meta.migrations where name = '$name'")" = 0 ] || continue
    { echo "set role dalil_owner;"; cat -- "$f"; echo "insert into dh_meta.migrations (name) values ('$name');"; } |
      pg -d "$DB" -1 -f - >/dev/null 2>"$STATE/migrate.log" ||
      { cat "$STATE/migrate.log" >&2; die "فشل تطبيق $name على قاعدة السيرفر"; }
  done
  rm -rf -- "$TMP"; TMP=
}

